{
  "name": "mi-cd-pipeline",
  "version": "1.0.0",
  "description": "Reto GitHub Actions - CD Pipeline (preview, staging, production, rollback)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
